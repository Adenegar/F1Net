{
  "ConnectionStrings": {
    "F1Net": "Server=(localdb)\\MSSQLLocalDB;Database=F1Net;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenF1": {
    "BaseUrl": "https://api.openf1.org/v1/"
  },
  "Ergast": {
    "BaseUrl": "https://ergast.com/api/f1/"
  },
  "Ingestion": {
    "Enabled": true,
    "Interval": "00:15:00",
    "CurrentYear": 2025,
    "DetectAnomaliesAfterIngest": true
  },
  "Auth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Sync": {
      "ClientId": "f1net-sync",
      "ClientSecret": "",
      "DisplayName": "F1Net Weekly Sync"
    }
  }
}
