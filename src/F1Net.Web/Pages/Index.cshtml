@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<section class="grid two">
    <div class="card">
        <h2>Driver Standings — <span id="standings-year">@Model.Year</span></h2>
        <table id="standings-table" class="data">
            <thead><tr><th>#</th><th>Driver</th><th>Team</th><th>Pts</th><th>W</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="card">
        <h2>Recent Sessions</h2>
        <table id="sessions-table" class="data">
            <thead><tr><th>Race</th><th>Session</th><th>Laps</th><th>Anomalies</th></tr></thead>
            <tbody></tbody>
        </table>
    </div>
</section>

<section class="card">
    <h2>Points Leader Pace — Last Session</h2>
    <canvas id="pace-chart" height="120"></canvas>
</section>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script>F1Net.Dashboard.init(@Model.Year);</script>
}
